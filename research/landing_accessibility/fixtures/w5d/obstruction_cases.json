{
  "_about": [
    "W5D task-specific obstruction 대조군 fixture.",
    "viewport 는 03 §1 고정값 390x844 CSS px.",
    "task_control_bbox 는 우상단 진입 control (x 270..370, y 20..64, 면적 4400 px^2).",
    "각 case 의 expect 는 measurement 수준(step 요약) 기대값이고,",
    "expect_rows 는 interrupt 단위 원자료 기대값이다 — 요약이 원자료를 대체하지 않는다."
  ],
  "viewport": { "width": 390, "height": 844 },
  "task_control_bbox": { "x": 270, "y": 20, "w": 100, "h": 44 },
